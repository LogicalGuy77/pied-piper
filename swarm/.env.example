# Copy to swarm/.env (git ignores it) and fill in. The tracker reads it at start.

# Private key of the saver wallet: it pays for and owns every conversation
# entity on Arkiv's Rabdi testnet. Use a throwaway testnet key, funded with
# tGLM from https://hub.arkiv.network/faucet. Leave empty to turn saving off.
ARKIV_PRIVATE_KEY=

# Optional. The public RPC is heavily rate limited; a free key from
# https://hub.arkiv.network/access-keys lifts that. It is not a secret.
ARKIV_ACCESS_KEY=

# --- Rewards: PIPER on Unichain Sepolia ---

# Your Privy app's ID (dashboard.privy.io). Phones then get a Privy guest
# wallet on their first visit. In the dashboard, turn on guest accounts, email
# and SMS login, and add the page's origin (your tunnel's https:// URL) to the
# allowed domains. Not a secret. Leave empty for wallets kept in the browser.
PRIVY_APP_ID=

# Private key of the treasury: it deploys PIPER (node swarm/chain/deploy.js),
# holds the supply, pays phones, and pays the gas of their withdrawals. Fund
# it with Unichain Sepolia ETH. Leave empty to only count earnings.
TREASURY_PRIVATE_KEY=

# Optional. The token, if not the one in swarm/chain/deployment.json.
PIPER_TOKEN=

# Optional. Another Unichain Sepolia RPC; the default is https://sepolia.unichain.org.
CHAIN_RPC_URL=
