{
  "name": "swarm-engine",
  "private": true,
  "type": "module",
  "description": "Stage engine for phone swarm inference: runs a range of model layers in plain JS",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "check": "node test/check.js",
    "check:js": "KERNELS=js node test/check.js",
    "check:int8": "node test/check.js ../weights/smollm2-135m-instruct-int8 ../testvectors-int8",
    "check:big": "node test/check.js ../weights/minicpm5-2b-int8 ../testvectors-minicpm5-2b-int8"
  },
  "devDependencies": {
    "wabt": "^1.0.37"
  }
}
